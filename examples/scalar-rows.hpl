<?xml version="1.0" ?>
<pipeline>
  <info>
    <name>valid</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>MODEL_DIR</name>
        <default_value>${PROJECT_HOME}/examples</default_value>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>Input</from>
      <to>Validate</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate</from>
      <to>Output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Input</name>
    <type>DataGrid</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <fields>
      <field>
        <name>key</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>amount</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>start</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>finish</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>extra</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <data>
      <line>
        <item>0</item>
        <item>3</item>
        <item>1</item>
        <item>2</item>
        <item>extra-0</item>
      </line>
      <line>
        <item>1</item>
        <item>3</item>
        <item>1</item>
        <item>2</item>
        <item>extra-1</item>
      </line>
      <line>
        <item>2</item>
        <item>3</item>
        <item>1</item>
        <item>2</item>
        <item>extra-2</item>
      </line>
      <line>
        <item>3</item>
        <item>3</item>
        <item>1</item>
        <item>2</item>
        <item>extra-3</item>
      </line>
    </data>
    <GUI>
      <xloc>100</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Validate</name>
    <type>INTERLIS_ROW_VALIDATOR_TRANSFORM</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <modelNames>Rows</modelNames>
    <modelSources>${MODEL_DIR}</modelSources>
    <className>Rows.Data.Row</className>
    <singlePassOnly>N</singlePassOnly>
    <cacheRows>1</cacheRows>
    <compress>Y</compress>
    <tempDirectory/>
    <reportDirectory/>
    <sourceRowField>extra</sourceRowField>
    <mappings>
      <mapping>
        <attribute>key</attribute>
        <field>key</field>
      </mapping>
      <mapping>
        <attribute>amount</attribute>
        <field>amount</field>
      </mapping>
      <mapping>
        <attribute>start</attribute>
        <field>start</field>
      </mapping>
      <mapping>
        <attribute>finish</attribute>
        <field>finish</field>
      </mapping>
    </mappings>
    <GUI>
      <xloc>340</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Output</name>
    <type>WriteToLog</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <logmessage>Validated row</logmessage>
    <fields>
      <field>
        <name>key</name>
      </field>
      <field>
        <name>amount</name>
      </field>
      <field>
        <name>start</name>
      </field>
      <field>
        <name>finish</name>
      </field>
      <field>
        <name>extra</name>
      </field>
    </fields>
    <GUI>
      <xloc>580</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
</pipeline>
