<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.so.agi</groupId>
    <artifactId>hop-plugin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>ch.so.agi</groupId>
  <artifactId>hop-interlis-row-validator-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>hop-interlis-row-validator-plugin</name>
  <description>Model-based validation of Apache Hop row streams</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <modules>
    <module>core</module>
    <module>transform</module>
    <module>assemblies/plugin</module>
  </modules>
  <properties>
    <swt.version>3.134.0</swt.version>
    <swt.artifactId>org.eclipse.swt.gtk.linux.x86_64</swt.artifactId>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ch.interlis</groupId>
        <artifactId>iox-ili</artifactId>
        <version>1.24.4</version>
      </dependency>
      <dependency>
        <groupId>ch.interlis</groupId>
        <artifactId>ili2c-core</artifactId>
        <version>5.6.8</version>
      </dependency>
      <dependency>
        <groupId>ch.interlis</groupId>
        <artifactId>ili2c-tool</artifactId>
        <version>5.6.8</version>
      </dependency>
      <dependency>
        <groupId>ch.interlis</groupId>
        <artifactId>iox-api</artifactId>
        <version>1.0.3</version>
      </dependency>
      <dependency>
        <groupId>ch.ehi</groupId>
        <artifactId>ehibasics</artifactId>
        <version>1.4.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <profiles>
    <profile>
      <id>linux</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <swt.artifactId>org.eclipse.swt.gtk.linux.x86_64</swt.artifactId>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <swt.artifactId>org.eclipse.swt.win32.win32.x86_64</swt.artifactId>
      </properties>
    </profile>
    <profile>
      <id>mac-arm</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <swt.artifactId>org.eclipse.swt.cocoa.macosx.aarch64</swt.artifactId>
        <ui.test.argLine>-XstartOnFirstThread</ui.test.argLine>
      </properties>
    </profile>
    <profile>
      <id>mac-intel</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <swt.artifactId>org.eclipse.swt.cocoa.macosx.x86_64</swt.artifactId>
        <ui.test.argLine>-XstartOnFirstThread</ui.test.argLine>
      </properties>
    </profile>
  </profiles>
</project>
