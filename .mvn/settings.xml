<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!-- Apply to dependencies and build plugins, including the pinned CI helper's
       repo1.maven.org repository. User settings (-s) still supply repositories
       and credentials; only Central is mirrored. -->
  <mirrors>
    <mirror>
      <id>central-apache</id>
      <name>Maven Central via the Apache endpoint</name>
      <url>https://repo.maven.apache.org/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
